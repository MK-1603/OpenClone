# OpenClone Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit .env or actual production credentials to version control.

# Application Environment (development | test | production)
OPENCLONE_ENV=development

# Host & Logging
OPENCLONE_HOST=127.0.0.1
OPENCLONE_PORT=3000
OPENCLONE_LOG_LEVEL=INFO

# Model Intelligence Engine (MIE) Configuration
# API keys are optional and only needed if calling remote model providers directly.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Local Runtime Database
OPENCLONE_DB_PATH=.openclone/workforce.sqlite3
OPENCLONE_MIE_DB=.openclone/mie.sqlite3

# Security & Verification
OPENCLONE_STRICT_SANDBOX=true
OPENCLONE_REQUIRE_INTERACTIVE_APPROVAL=true
