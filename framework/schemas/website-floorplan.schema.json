{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclone.dev/schemas/website-floorplan.schema.json",
  "title": "OpenClone Website Floorplan Engine (WFE) Schema",
  "description": "Deterministic spatial route blueprint and layout schema generated by the Website Floorplan Engine.",
  "type": "object",
  "required": [
    "floorplan_id",
    "project_name",
    "route_path",
    "archetype",
    "grid_system",
    "zones",
    "responsive_breakpoints"
  ],
  "properties": {
    "floorplan_id": {
      "type": "string",
      "pattern": "^WFE-[A-Z0-9_-]+$"
    },
    "project_name": {
      "type": "string"
    },
    "route_path": {
      "type": "string",
      "pattern": "^/.*$"
    },
    "archetype": {
      "type": "string",
      "enum": [
        "developer_platform",
        "data_analytics",
        "fintech_console",
        "enterprise_saas",
        "consumer_web",
        "healthcare_portal",
        "creative_suite",
        "ecommerce_storefront"
      ]
    },
    "density": {
      "type": "string",
      "enum": ["compact", "balanced", "spacious"],
      "default": "balanced"
    },
    "grid_system": {
      "type": "object",
      "required": ["columns", "gutter_px", "baseline_px"],
      "properties": {
        "columns": { "type": "integer", "enum": [4, 8, 12, 16] },
        "gutter_px": { "type": "integer", "enum": [16, 24, 32] },
        "baseline_px": { "type": "integer", "enum": [4, 8] }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zone_id", "zone_type", "col_span", "component_family"],
        "properties": {
          "zone_id": { "type": "string" },
          "zone_type": {
            "type": "string",
            "enum": ["header", "hero", "bento_grid", "workspace_primary", "workspace_secondary", "footer", "modal_overlay"]
          },
          "col_span": { "type": "integer", "minimum": 1, "maximum": 16 },
          "aspect_ratio": { "type": "string" },
          "component_family": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-9]|20)-[a-z-]+$"
          },
          "sticky": { "type": "boolean", "default": false },
          "contrast_scrim": { "type": "boolean", "default": true }
        }
      }
    },
    "responsive_breakpoints": {
      "type": "object",
      "required": ["mobile_sm", "tablet_md", "desktop_lg"],
      "properties": {
        "mobile_sm": { "type": "integer", "default": 390 },
        "tablet_md": { "type": "integer", "default": 768 },
        "desktop_lg": { "type": "integer", "default": 1440 }
      }
    }
  }
}
