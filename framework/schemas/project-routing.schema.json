{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclone.dev/schemas/project-routing.schema.json",
  "title": "OpenClone Project Routing Decision",
  "type": "object",
  "required": [
    "project_id",
    "timestamp",
    "classification",
    "domains",
    "capabilities",
    "workforce",
    "models",
    "workflows",
    "approval_gates"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "classification": {
      "type": "object"
    },
    "domains": {
      "type": "object",
      "required": ["mandatory", "conditional", "supporting", "optional", "not_applicable"],
      "properties": {
        "mandatory": { "type": "array", "items": { "type": "string" } },
        "conditional": { "type": "array", "items": { "type": "string" } },
        "supporting": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } },
        "not_applicable": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engine_id", "name", "status", "rationale"],
        "properties": {
          "engine_id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "rationale": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "workforce": {
      "type": "object",
      "required": ["native_agents", "external_agents", "human_specialists"],
      "properties": {
        "native_agents": { "type": "array", "items": { "type": "string" } },
        "external_agents": { "type": "array", "items": { "type": "string" } },
        "ide_agents": { "type": "array", "items": { "type": "string" } },
        "human_specialists": { "type": "array", "items": { "type": "string" } },
        "missing_specialists": { "type": "array", "items": { "type": "string" } }
      }
    },
    "models": {
      "type": "object",
      "required": ["primary_model", "fallback_chain"],
      "properties": {
        "primary_model": { "type": "string" },
        "fallback_chain": { "type": "array", "items": { "type": "string" } },
        "task_allocations": { "type": "object" }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow_id", "name", "stage"],
        "properties": {
          "workflow_id": { "type": "string" },
          "name": { "type": "string" },
          "stage": { "type": "integer" },
          "prerequisites": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "name", "approver_role"],
        "properties": {
          "gate_id": { "type": "string" },
          "name": { "type": "string" },
          "approver_role": { "type": "string" },
          "criteria": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "verification_strategy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
