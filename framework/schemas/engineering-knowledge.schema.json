{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclone.dev/schemas/engineering-knowledge.schema.json",
  "title": "OpenClone Canonical Engineering Knowledge Unit Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "title",
    "sector_id",
    "domain_id",
    "subdomain_id",
    "specialization_id",
    "knowledge_type",
    "description",
    "purpose",
    "technical_depth",
    "authority",
    "confidence",
    "status",
    "version",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EIS-KNOW-[0-9A-Za-z_-]+$"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "2.0"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sector_id": {
      "type": "string",
      "enum": [
        "EIS-01", "EIS-02", "EIS-03", "EIS-04", "EIS-05", "EIS-06", "EIS-07",
        "EIS-08", "EIS-09", "EIS-10", "EIS-11", "EIS-12", "EIS-13", "EIS-14",
        "EIS-15", "EIS-16", "EIS-17"
      ]
    },
    "domain_id": { "type": "string", "minLength": 1 },
    "subdomain_id": { "type": "string", "minLength": 1 },
    "specialization_id": { "type": "string", "minLength": 1 },
    "knowledge_type": {
      "enum": [
        "technical_concept",
        "engineering_principle",
        "architecture_pattern",
        "algorithm",
        "implementation_method",
        "industry_standard",
        "failure_pattern",
        "case_study"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "technical_depth": {
      "enum": ["introductory", "intermediate", "advanced", "expert"]
    },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "concepts": { "type": "array", "items": { "type": "string" } },
    "principles": { "type": "array", "items": { "type": "string" } },
    "methods": { "type": "array", "items": { "type": "string" } },
    "patterns": { "type": "array", "items": { "type": "string" } },
    "algorithms": { "type": "array", "items": { "type": "string" } },
    "tools": { "type": "array", "items": { "type": "string" } },
    "standards": { "type": "array", "items": { "type": "string" } },
    "use_cases": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "failure_modes": { "type": "array", "items": { "type": "string" } },
    "security_considerations": { "type": "array", "items": { "type": "string" } },
    "performance_considerations": { "type": "array", "items": { "type": "string" } },
    "validation_methods": { "type": "array", "items": { "type": "string" } },
    "related_knowledge": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "source_type"],
        "properties": {
          "uri": { "type": "string" },
          "source_type": { "type": "string" },
          "publisher": { "type": "string" },
          "revision": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "authority": {
      "enum": ["unverified", "proposed", "verified", "peer_reviewed", "standard"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "enum": ["proposed", "active", "deprecated", "superseded", "under_review"]
    },
    "version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"] }
  }
}
