{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclone.org/schemas/component-manifest.schema.json",
  "title": "OpenClone Component Manifest",
  "description": "Schema definition for OpenClone modular extension packages, tool packs, and skills.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "category",
    "min_platform_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-_]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["skill", "mcp-pack", "agent-adapter", "workflow-pack", "runtime-adapter", "tool-pack"]
    },
    "min_platform_version": {
      "type": "string"
    },
    "max_platform_version": {
      "type": ["string", "null"]
    },
    "entrypoint": {
      "type": ["string", "null"]
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
