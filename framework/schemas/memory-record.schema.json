{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclone.dev/schemas/memory-record.schema.json",
  "title": "OpenClone Persistent Memory Record Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "title",
    "memory_type",
    "scope",
    "statement",
    "classification",
    "status",
    "authority",
    "recorded_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^MEM-[0-9A-Za-z_-]+$"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "2.0"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "memory_type": {
      "enum": [
        "project_fact",
        "decision",
        "session_checkpoint",
        "lesson",
        "preference",
        "knowledge_reference",
        "working_memory"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "project_id",
        "workspace_id"
      ],
      "properties": {
        "user_id": {
          "type": ["string", "null"]
        },
        "organization_id": {
          "type": ["string", "null"]
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": ["string", "null"]
        },
        "owner": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": ["string", "null"]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "status": {
      "enum": [
        "CURRENT",
        "REVIEW_DUE",
        "STALE",
        "SUPERSEDED",
        "DISPUTED",
        "UNVERIFIED",
        "ARCHIVED"
      ]
    },
    "authority": {
      "enum": [
        "unverified",
        "verified",
        "human_confirmed"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string"
          },
          "revision_or_date": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "observed_at": {
      "type": ["string", "null"]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": ["string", "null"]
    },
    "review_due_at": {
      "type": ["string", "null"]
    },
    "expires_at": {
      "type": ["string", "null"]
    },
    "approved_by": {
      "type": ["string", "null"]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": ["string", "null"]
    }
  }
}
