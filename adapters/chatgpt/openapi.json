{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenClone Universal AI Tool Integration API",
    "version": "1.0.0",
    "description": "Provider-neutral HTTP REST API exposing OpenClone canonical engineering capabilities to external AI hosts (ChatGPT Actions, webhooks, automation runtimes).",
    "contact": {
      "name": "OpenClone Architecture Team",
      "url": "https://github.com/MK-1603/OpenClone"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://api.openclone.org/v1",
      "description": "OpenClone Integration Gateway"
    }
  ],
  "paths": {
    "/capabilities/openclone_approve_release_deployment": {
      "post": {
        "summary": "Approve Release Deployment",
        "description": "Cryptographically authorize deployment rollout across target cloud platform (WF-014).",
        "operationId": "openclone_approve_release_deployment",
        "tags": [
          "handoff_release"
        ],
        "security": [
          {
            "BearerAuth": [
              "release:approve"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deployed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token"
          },
          "403": {
            "description": "Forbidden / Insufficient Scopes"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "target_environment": {
                    "type": "string",
                    "enum": [
                      "staging",
                      "production"
                    ]
                  },
                  "approval_digest": {
                    "type": "string",
                    "description": "SHA-256 human approval digest"
                  }
                },
                "required": [
                  "target_environment",
                  "approval_digest"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/capabilities/openclone_create_defect": {
      "post": {
        "summary": "Log Defect",
        "description": "Create a tracked defect blocking phase gate until resolved.",
        "operationId": "openclone_create_defect",
        "tags": [
          "defects_gates"
        ],
        "security": [
          {
            "BearerAuth": [
              "defects:write"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "defect_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token"
          },
          "403": {
            "description": "Forbidden / Insufficient Scopes"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH",
                      "CRITICAL"
                    ]
                  },
                  "reproduction_steps": {
                    "type": "string"
                  }
                },
                "required": [
                  "item_id",
                  "title",
                  "severity"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/capabilities/openclone_generate_ide_handoff": {
      "get": {
        "summary": "Generate Scoped IDE Handoff",
