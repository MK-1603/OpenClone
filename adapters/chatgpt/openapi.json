    "/capabilities/openclone_submit_evidence": {
      "post": {
        "summary": "Submit Evidence Artifact",
        "description": "Attach verifiable proof (code diff, test output, or screenshot) to a checklist item.",
        "operationId": "openclone_submit_evidence",
        "tags": [
          "evidence_verification"
        ],
        "security": [
          {
            "BearerAuth": [
              "evidence:write"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "evidence_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token"
          },
          "403": {
            "description": "Forbidden / Insufficient Scopes"
          }
        },
        "requestBody": {
          "required": true,
