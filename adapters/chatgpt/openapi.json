                      "type": "string"
                    }
                  },
                  "test_pass_count": {
                    "type": "integer"
                  },
                  "test_fail_count": {
                    "type": "integer"
                  }
                },
                "required": [
                  "task_id",
                  "modified_files",
                  "commands_run"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/capabilities/openclone_update_task_status": {
      "post": {
        "summary": "Update Task Status",
        "description": "Advance lifecycle task state. Transition to VERIFIED strictly requires verified EvidenceRecord.",
        "operationId": "openclone_update_task_status",
        "tags": [
          "lifecycle_tasks"
        ],
        "security": [
          {
            "BearerAuth": [
              "tasks:write"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / Missing Token"
          },
          "403": {
            "description": "Forbidden / Insufficient Scopes"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item_id": {
                    "type": "string",
                    "description": "Checklist task ID"
                  },
                  "new_status": {
                    "type": "string",
                    "enum": [
                      "NOT_STARTED",
                      "IN_PROGRESS",
                      "BLOCKED",
                      "READY_FOR_VERIFICATION",
                      "VERIFIED",
                      "WAIVED_WITH_APPROVAL"
                    ]
                  },
                  "evidence_path": {
                    "type": "string",
                    "description": "Required if advancing to VERIFIED"
                  }
                },
                "required": [
                  "item_id",
                  "new_status"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
