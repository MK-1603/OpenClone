    "/capabilities/openclone_submit_implementation_report": {
      "post": {
        "summary": "Submit Implementation Report",
        "description": "Submit IDE completion report including modified files, commands executed, and test pass counts.",
        "operationId": "openclone_submit_implementation_report",
        "tags": [
          "lifecycle_tasks"
        ],
        "security": [
          {
            "BearerAuth": [
